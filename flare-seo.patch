+:root {
+  color-scheme: dark;
+  --bg: #0c0c0d;
+  --fg: #f1eee8;
+  --muted: #a8a399;
+  --line: #2b2a27;
+  --accent: #f27a2c;
+}
+* { box-sizing: border-box; }
+html { -webkit-text-size-adjust: 100%; }
+body {
+  margin: 0;
+  background: var(--bg);
+  color: var(--fg);
+  font-family: "Source Serif 4", Georgia, "Times New Roman", serif;
+  font-size: 1.0625rem;
+  line-height: 1.7;
+  padding: env(safe-area-inset-top, 0px) 1.25rem env(safe-area-inset-bottom, 0px);
+}
+.wrap { max-width: 42rem; margin: 0 auto; padding: 1.5rem 0 3rem; }
+.top { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding-bottom: 1.25rem; border-bottom: 1px solid var(--line); }
+.brand { display: inline-flex; align-items: center; gap: 0.6rem; color: var(--fg); text-decoration: none; font-size: 1.25rem; font-weight: 600; }
+.brand svg { width: 1.6rem; height: 1.6rem; }
+.nav { display: flex; flex-wrap: wrap; gap: 1.1rem; font-size: 0.95rem; }
+a { color: var(--fg); text-decoration-color: var(--accent); text-underline-offset: 0.2em; }
+a:hover { color: var(--accent); }
+a:focus-visible, .cta:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
+h1 { font-size: clamp(2rem, 6vw, 3.1rem); line-height: 1.12; letter-spacing: -0.015em; font-weight: 600; margin: 3rem 0 1.25rem; }
+h2 { font-size: 1.45rem; line-height: 1.3; margin: 2.75rem 0 0.75rem; font-weight: 600; }
+h3 { font-size: 1.1rem; margin: 1.75rem 0 0.4rem; }
+.lead { font-size: 1.2rem; color: var(--fg); margin: 0 0 1.75rem; }
+p { margin: 0 0 1rem; }
+.muted { color: var(--muted); }
+.cta { display: inline-block; background: var(--accent); color: #140b04; font-weight: 600; text-decoration: none; padding: 0.7rem 1.35rem; border-radius: 6px; }
+.cta:hover { color: #140b04; filter: brightness(1.08); }
+dl { margin: 0; }
+.row { padding: 1rem 0; border-top: 1px solid var(--line); }
+.row:last-child { border-bottom: 1px solid var(--line); }
+dt { font-weight: 600; }
+dd { margin: 0.15rem 0 0; color: var(--muted); }
+ul { padding-left: 1.2rem; margin: 0 0 1rem; }
+li { margin-bottom: 0.35rem; }
+.langs { display: flex; flex-wrap: wrap; gap: 1rem; margin: 1.5rem 0 0; font-size: 0.95rem; }
+section.doc { padding-top: 0.5rem; }
+.updated { color: var(--muted); font-size: 0.92rem; margin: -0.25rem 0 1.5rem; }
+footer { margin-top: 3.5rem; padding-top: 1.25rem; border-top: 1px solid var(--line); color: var(--muted); font-size: 0.92rem; }
+footer a { color: var(--muted); }
